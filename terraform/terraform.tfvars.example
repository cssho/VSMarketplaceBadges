# terraform.tfvars.example
# コピーして terraform.tfvars を作る (terraform.tfvars は .gitignore 済み)。
#
# 稼働中の環境をそのまま再現する値は variables.tf の既定値に入っている。
# つまり terraform.tfvars が無くても素の `terraform apply` で現状と一致する。
# このファイルは「既定から変えたいとき」に使う。

# --- 通常は触らない -----------------------------------------------------------
# region        = "ap-northeast-1"
# function_name = "vsmarketplace-badges"
# domain_name   = "vsmarketplacebadges.dev"

# --- チューニング -------------------------------------------------------------
# 請求実績を見て調整する。Lambda はメモリに比例して CPU も増えるため、
# 下げれば必ず安くなるとは限らない (実行時間が延びて相殺される)。
# lambda_memory_size = 1024
# log_retention_days = 14
# price_class        = "PriceClass_200"

# --- 切り戻し -----------------------------------------------------------------
# CloudFront のオリジンを Lambda から App Runner に切り替える。
# 反映は CloudFront の伝播 (数分)。DNS には触れない。
# ただし App Runner は 2022 年のコードを配信する (CLAUDE.md 参照)。
# rollback_to_apprunner = true

# --- 新しい環境をゼロから構築するときだけ ---------------------------------------
# 初回 apply はプレースホルダー ZIP のため SnapStart のバージョン発行に失敗する。
# 実コードを CI でデプロイしてから true に戻す。README.md「初回構築」を参照。
# enable_snapstart = false
#
# 段階移行のために証明書と DNS を後から有効化する場合。
# **稼働中の環境で false にすると証明書とホストゾーンが消えて本番が止まる。**
# enable_custom_domain = false
# manage_dns           = false
